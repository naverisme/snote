{
  "name": "snote-v2",
  "private": true,
  "packageManager": "npm@11.15.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "contract:http": "node packages/contracts/tests/http-fixture.mjs",
    "contract:generate": "openapi-typescript docs/contracts/openapi.yaml -o packages/contracts/src/schema.ts",
    "contract:validate": "python tools/validate_contract.py",
    "test:e2e": "node --test tests/e2e/*.spec.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3"
  }
}
