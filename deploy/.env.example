# Copy to deploy/.env.local and replace this password before first start.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://snote:replace-with-a-long-random-password@db:5432/snote?schema=public

# Local Docker: http://localhost:8080. Public deployment: set SITE_ADDRESS to a DNS name,
# PUBLIC_BASE_URL to https://that-name, HTTP_PORT=80 and HTTPS_PORT=443.
SITE_ADDRESS=http://localhost
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443
BIND_ADDRESS=127.0.0.1
MAX_STORAGE_BYTES=1073741824

# Same Google Web Client ID on both sides; include the exact site origin in Google Console.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# For public deployment use a real SMTP provider. Local override uses Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
